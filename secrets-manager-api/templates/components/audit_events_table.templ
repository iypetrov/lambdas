package components

import (
	"time"
	"github.com/iypetrov/lambdas/secrets-manager-api/metadata"
)

templ AuditEventsTable(events []metadata.AuditTLSEvent, env string) {
	<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
		<div class="p-4 border-b border-gray-200 bg-gray-50">
			<h3 class="text-lg font-semibold text-gray-900">Audit Events</h3>
		</div>
		<table class="w-full">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cluster</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Secret Name</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expires At</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				if len(events) == 0 {
					<tr>
						<td colspan="3" class="px-6 py-8 text-center text-gray-500">
							No audit events found.
						</td>
					</tr>
				} else {
					for _, event := range events {
						<tr class="hover:bg-gray-50">
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm font-medium text-gray-900">{ event.Action }</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm text-gray-500">{ event.Cluster }</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm text-gray-500">{ event.SecretName }</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm text-gray-500">
									if event.ExpireAt > 0 {
										{ time.Unix(event.ExpireAt, 0).UTC().Format(time.RFC3339) }
									} else {
										<span class="text-gray-400">-</span>
									}
								</div>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

