package components

import (
	"encoding/base64"
	"fmt"
	"net/url"
	"github.com/iypetrov/lambdas/secrets-manager-api/secrets"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/button"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/icon"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/input"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/label"
)

templ TLSCertificatesTable(secrets []secrets.Secret, env string, searchName string, searchTagFilters map[string]string, allTagPairs []secrets.TagPair) {
	<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden" x-data={ fmt.Sprintf("tlsCertificatesFilters({ searchName: %q, searchTags: %s, env: %q })", searchName, formatTagFilters(searchTagFilters), env) }>
		<div class="p-4 border-b border-gray-200 bg-gray-50">
			<input type="hidden" name="cluster" x-bind:value="$store.cluster.selectedCluster || ''" />
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<div>
					@label.Label(label.Props{
						For: "tls-certificates-search-name",
					}) {
						Search by Name
					}
					@input.Input(input.Props{
						ID: "tls-certificates-search-name",
						Type: input.TypeSearch,
						Placeholder: "Enter name to search...",
						Value: searchName,
						Attributes: templ.Attributes{
							"x-model": "searchName",
							"name": "search-name",
							"x-on:input": "triggerSearch()",
						},
						Class: "mt-1",
					})
				</div>
				<div>
					@label.Label(label.Props{
						For: "tls-certificates-search-tags",
					}) {
						Search by Tags
					}
					<div class="mt-1">
						<div class="mb-2">
							<select
								x-model="selectedTagPair"
								class="flex h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none md:text-sm focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]"
								x-on:change="if(selectedTagPair) { const [key, value] = selectedTagPair.split(':'); searchTags[key] = value; selectedTagPair = ''; triggerSearch(); }"
							>
								<option value="">Select tag...</option>
								for _, pair := range allTagPairs {
									<option value={ fmt.Sprintf("%s:%s", pair.Key, pair.Value) }>{ fmt.Sprintf("%s: %s", pair.Key, pair.Value) }</option>
								}
							</select>
						</div>
						<div class="flex flex-wrap gap-2 min-h-[2rem] mb-2">
							<template x-for="(value, key) in searchTags" :key="key">
								<div class="flex items-center gap-1 px-3 py-1 bg-blue-50 border border-blue-200 rounded-full text-sm">
									<span class="font-medium text-blue-900" x-text="key"></span>
									<span class="text-blue-700">:</span>
									<span class="text-blue-800" x-text="value"></span>
									<button
										type="button"
										x-on:click="delete searchTags[key]; triggerSearch();"
										class="ml-1 text-blue-600 hover:text-blue-800 font-bold"
									>
										×
									</button>
									<input type="hidden" x-bind:name="'search-tag-key[' + key + ']'" x-bind:value="key" />
									<input type="hidden" x-bind:name="'search-tag-value[' + key + ']'" x-bind:value="value" />
								</div>
							</template>
						</div>
					</div>
				</div>
			</div>
		</div>
		<script>
			function tlsCertificatesFilters(initial) {
				return {
					searchName: initial.searchName || '',
					searchTags: initial.searchTags || {},
					selectedTagPair: '',
					env: initial.env,
					triggerSearch() {
						const cluster = Alpine.store('cluster').selectedCluster || '';
						let url = '/' + this.env + '/api/v0/tls-certificates?cluster=' + cluster;
						if (this.searchName) {
							url += '&search-name=' + encodeURIComponent(this.searchName);
						}
						for (const [key, value] of Object.entries(this.searchTags)) {
							url += '&search-tag-key[' + encodeURIComponent(key) + ']=' + encodeURIComponent(key);
							url += '&search-tag-value[' + encodeURIComponent(key) + ']=' + encodeURIComponent(value);
						}
						htmx.ajax('GET', url, { target: '#tls-certificates-table', swap: 'innerHTML' });
					}
				}
			}
		</script>
		<table class="w-full">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cluster</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
					<th class="px-2 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				if len(secrets) == 0 {
					<tr>
						<td colspan="4" class="px-6 py-8 text-center text-gray-500">
							No certificates found. Import one to get started.
						</td>
					</tr>
				} else {
					for _, secret := range secrets {
						<tr class="hover:bg-gray-50">
							<td class="px-6 py-4 whitespace-nowrap">
								<a href={ fmt.Sprintf("/%s/p/tls-certificates/%s", env, base64.URLEncoding.EncodeToString([]byte(secret.Name))) } class="text-sm font-medium text-blue-600 hover:text-blue-800 cursor-pointer">
									{ secret.Name }
								</a>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm text-gray-500">{ secret.Cluster }</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm text-gray-500">
									if secret.CreatedDate != "" {
										{ secret.CreatedDate }
									} else {
										<span class="text-gray-400">-</span>
									}
								</div>
							</td>
							<td class="px-2 py-4 whitespace-nowrap text-sm font-medium">
								<div class="flex justify-end">
									@button.Button(button.Props{
										Variant: button.VariantDestructive,
										Size: button.SizeSm,
										Attributes: templ.Attributes{
											"hx-delete": fmt.Sprintf("/%s/api/v0/tls-certificates?name=%s", env, url.QueryEscape(secret.Name)),
											"hx-confirm": "Are you sure you want to delete this certificate?",
											"hx-target": "#tls-certificates-table",
											"hx-swap": "innerHTML",
										},
									}) {
										<span class="button-text">Delete</span>
										@icon.LoaderCircle(icon.Props{
											Size: 16,
											Class: "htmx-indicator animate-spin",
										})
									}
								</div>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

