package views

import (
	"fmt"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/components"
)

type LayoutProps struct {
	Env        string
	ActivePage string
}

templ Layout(props LayoutProps) {
	@templates.Base() {
		<div class="flex min-h-screen w-full" x-data="{ showCreateStaticModal: false, showCreateTLSModal: false, showValueModal: false, selectedCluster: '' }">
			<aside class="w-64 bg-gray-900 min-h-screen flex flex-col">
				<div class="w-full p-6 flex flex-col items-center justify-center border-b border-gray-800">
					<div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mb-2">
						<span class="text-white font-bold text-xl">SM</span>
					</div>
					<h1 class="text-xl font-bold text-gray-200">Secrets Manager</h1>
					<p class="text-sm text-gray-400 mt-1">Admin Portal</p>
				</div>

				<nav class="px-4 py-4 flex-1">
					@components.SideBarLink(components.SideBarLinkProps{
						Name:   "Dashboard",
						URL:    fmt.Sprintf("/%s/p/home", props.Env),
						Active: props.ActivePage == "home",
					})
					@components.SideBarLink(components.SideBarLinkProps{
						Name:   "Static Secrets",
						URL:    fmt.Sprintf("/%s/p/static-secrets", props.Env),
						Active: props.ActivePage == "static-secrets",
					})
					@components.SideBarLink(components.SideBarLinkProps{
						Name:   "TLS Certificates",
						URL:    fmt.Sprintf("/%s/p/tls-certificates", props.Env),
						Active: props.ActivePage == "tls-certificates",
					})
				</nav>
			</aside>

			@templates.Page() {
				{ children... }
			}

			<!-- Create Static Secret Modal -->
			<div
				x-show="showCreateStaticModal"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
				class="fixed inset-0 z-50 flex items-center justify-center"
				style="background-color: rgba(0, 0, 0, 0.2); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
				x-on:click.self="showCreateStaticModal = false; htmx.trigger('body', 'refresh')"
			>
				<div
					class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto"
					x-transition:enter="transition ease-out duration-300"
					x-transition:enter-start="opacity-0 transform scale-95"
					x-transition:enter-end="opacity-100 transform scale-100"
					x-transition:leave="transition ease-in duration-200"
					x-transition:leave-start="opacity-100 transform scale-100"
					x-transition:leave-end="opacity-0 transform scale-95"
				>
					<div class="p-6">
						<h3 class="text-2xl font-bold mb-4 text-gray-900">
							Create Static Secret
						</h3>
						<form
							hx-post={ fmt.Sprintf("/%s/api/v0/secrets", props.Env) }
							hx-target="#static-secrets-table"
							hx-swap="innerHTML"
							@htmx:after-request="showCreateStaticModal = false"
						>
							<input type="hidden" name="type" value="Static Secret" />
							
							@CreateStaticSecretForm(props.Env)
						</form>
					</div>
				</div>
			</div>

			<!-- Create TLS Certificate Modal -->
			<div
				x-show="showCreateTLSModal"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
				class="fixed inset-0 z-50 flex items-center justify-center"
				style="background-color: rgba(0, 0, 0, 0.2); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
				x-on:click.self="showCreateTLSModal = false; htmx.trigger('body', 'refresh')"
			>
				<div
					class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto"
					x-transition:enter="transition ease-out duration-300"
					x-transition:enter-start="opacity-0 transform scale-95"
					x-transition:enter-end="opacity-100 transform scale-100"
					x-transition:leave="transition ease-in duration-200"
					x-transition:leave-start="opacity-100 transform scale-100"
					x-transition:leave-end="opacity-0 transform scale-95"
				>
					<div class="p-6">
						<h3 class="text-2xl font-bold mb-4 text-gray-900">
							Create TLS Certificate
						</h3>
						<form
							hx-post={ fmt.Sprintf("/%s/api/v0/secrets", props.Env) }
							hx-target="#tls-certificates-table"
							hx-swap="innerHTML"
							@htmx:after-request="showCreateTLSModal = false"
						>
							<input type="hidden" name="type" value="TLS Certificate" />
							
							@CreateTLSCertificateForm(props.Env)
						</form>
					</div>
				</div>
			</div>

			<div
				x-show="showValueModal"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
				class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50"
				style="display: none;"
				x-on:click.self="showValueModal = false"
			>
				<div
					id="secret-value-modal"
					class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto"
					x-transition:enter="transition ease-out duration-300"
					x-transition:enter-start="opacity-0 transform scale-95"
					x-transition:enter-end="opacity-100 transform scale-100"
					x-transition:leave="transition ease-in duration-200"
					x-transition:leave-start="opacity-100 transform scale-100"
					x-transition:leave-end="opacity-0 transform scale-95"
				>
				</div>
			</div>
		</div>
	}
}
