package views

import (
	"fmt"
	"net/url"
	"github.com/iypetrov/lambdas/secrets-manager-api/secrets"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/button"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/form"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/input"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/textarea"
	"github.com/iypetrov/lambdas/secrets-manager-api/utils"
)

type SideBarLinkProps struct {
	Name  string
	Active bool
}

templ SideBarLink(props SideBarLinkProps) {
	<button
		class={ utils.TwMerge(
			"flex items-center gap-3 px-4 py-3 rounded-lg mb-2 transition-colors w-full text-left",
			utils.IfElse(props.Active, "bg-gray-800 text-white", "text-gray-300 hover:bg-gray-800 hover:text-white"),
		) }
		x-on:click={ fmt.Sprintf("activeTab = '%s'", props.Name) }
	>
		<span>{ props.Name }</span>
	</button>
}

templ HomePage(stats *secrets.Statistics, env string) {
	@templates.Base() {
		<div class="flex min-h-screen w-full" x-data="{ activeTab: '', showCreateModal: false, secretType: 'static', showValueModal: false, selectedCluster: '' }">
			<aside class="w-64 bg-gray-900 min-h-screen flex flex-col">
				<div class="w-full p-6 flex flex-col items-center justify-center border-b border-gray-800">
					<div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mb-2">
						<span class="text-white font-bold text-xl">SM</span>
					</div>
					<h1 class="text-xl font-bold text-gray-200">Secrets Manager</h1>
					<p class="text-sm text-gray-400 mt-1">Admin Portal</p>
				</div>

				<nav class="px-4 py-4 flex-1">
					@SideBarLink(SideBarLinkProps{
						Name: "Static Secrets",
						Active: false,
					})
					@SideBarLink(SideBarLinkProps{
						Name: "TLS Certificates",
						Active: false,
					})
				</nav>
			</aside>

			@templates.Page() {
				<div class="w-full">
					<div class="flex justify-between items-center mb-6">
						<div>
							<h1 class="text-3xl font-bold mb-2 text-gray-900">Dashboard</h1>
							<p class="text-gray-600">Manage your secrets and TLS certificates</p>
						</div>
						<div class="flex items-center gap-4">
							<label class="text-sm font-medium text-gray-700">Cluster:</label>
							<select
								x-model="selectedCluster"
								x-on:change="htmx.trigger('body', 'refresh')"
								class="px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500"
								hx-get={ fmt.Sprintf("/%s/api/v0/clusters", env) }
								hx-trigger="load"
								hx-swap="innerHTML"
								hx-target="this"
								hx-on::after-swap="if(this.options.length > 0 && this.options[0].value) { selectedCluster = this.options[0].value; htmx.trigger('body', 'refresh'); }"
							>
								<option value="">Loading clusters...</option>
							</select>
						</div>
					</div>

					<!-- Statistics View (shown when no tab is active) -->
					<div x-show="activeTab === ''" x-transition>
						<div
							id="statistics"
							x-bind:hx-get={ fmt.Sprintf("'/%s/api/v0/statistics?cluster=' + (selectedCluster || '')", env) }
							hx-trigger="load, refresh from:body"
							hx-swap="innerHTML"
							hx-target="this"
						>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
								<div class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-lg p-6 transition">
									<h3 class="font-semibold text-lg mb-2 text-gray-700">Static Secrets</h3>
									<p class="text-3xl font-bold text-gray-900">{ fmt.Sprintf("%d", stats.StaticSecretsCount) }</p>
									<p class="text-sm text-gray-500 mt-2">Total static secrets</p>
								</div>

								<div class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-lg p-6 transition">
									<h3 class="font-semibold text-lg mb-2 text-gray-700">TLS Certificates</h3>
									<p class="text-3xl font-bold text-gray-900">{ fmt.Sprintf("%d", stats.TLSCertificatesCount) }</p>
									<p class="text-sm text-gray-500 mt-2">Total TLS certificates</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Static Secrets Tab -->
					<div x-show="activeTab === 'Static Secrets'" x-transition>
						<div class="mb-4 flex justify-between items-center">
							<h2 class="text-2xl font-bold text-gray-900">Static Secrets</h2>
							@button.Button(button.Props{
								Variant: button.VariantDefault,
								Attributes: templ.Attributes{
									"x-on:click": "showCreateModal = true; secretType = 'static'; setTimeout(() => htmx.trigger('#cluster', 'load'), 100)",
								},
							}) {
								<span>+ Create Secret</span>
							}
						</div>
						<div id="static-secrets-table" x-bind:hx-get={ fmt.Sprintf("'/%s/api/v0/secrets?type=static&cluster=' + (selectedCluster || '')", env) } hx-trigger="load, refresh from:body" hx-swap="innerHTML" hx-target="this">
							<div class="flex items-center justify-center p-8">
								<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
							</div>
						</div>
					</div>

					<!-- TLS Certificates Tab -->
					<div x-show="activeTab === 'TLS Certificates'" x-transition>
						<div class="mb-4 flex justify-between items-center">
							<h2 class="text-2xl font-bold text-gray-900">TLS Certificates</h2>
							@button.Button(button.Props{
								Variant: button.VariantDefault,
								Attributes: templ.Attributes{
									"x-on:click": "showCreateModal = true; secretType = 'tls'; setTimeout(() => htmx.trigger('#cluster', 'load'), 100)",
								},
							}) {
								<span>+ Create Certificate</span>
							}
						</div>
						<div id="tls-certificates-table" x-bind:hx-get={ fmt.Sprintf("'/%s/api/v0/secrets?type=tls&cluster=' + (selectedCluster || '')", env) } hx-trigger="load, refresh from:body" hx-swap="innerHTML" hx-target="this">
							<div class="flex items-center justify-center p-8">
								<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
							</div>
						</div>
					</div>
				</div>
			}

			<!-- Create Secret Modal -->
			<div
				x-show="showCreateModal"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
				class="fixed inset-0 z-50 flex items-center justify-center"
				style="background-color: rgba(0, 0, 0, 0.2); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
				x-on:click.self="showCreateModal = false"
			>
				<div
					class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto"
					x-transition:enter="transition ease-out duration-300"
					x-transition:enter-start="opacity-0 transform scale-95"
					x-transition:enter-end="opacity-100 transform scale-100"
					x-transition:leave="transition ease-in duration-200"
					x-transition:leave-start="opacity-100 transform scale-100"
					x-transition:leave-end="opacity-0 transform scale-95"
				>
					<div class="p-6">
						<h3 class="text-2xl font-bold mb-4 text-gray-900">
							Create <span x-text="secretType === 'static' ? 'Static Secret' : 'TLS Certificate'"></span>
						</h3>
						<form
							hx-post={ fmt.Sprintf("/%s/api/v0/secrets", env) }
							hx-swap="none"
							@htmx:after-request="if($event.detail.successful) { showCreateModal = false; htmx.trigger('body', 'refresh'); }"
						>
							<input type="hidden" name="type" x-bind:value="secretType === 'static' ? 'Static Secret' : 'TLS Certificate'" />
							
							@form.Item() {
								@form.Label(form.LabelProps{For: "cluster"}) {
									Cluster Name
								}
								<select
									name="cluster"
									id="cluster"
									required
									x-model="selectedCluster"
									class="flex h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none md:text-sm dark:bg-input/30 focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]"
									hx-get={ fmt.Sprintf("/%s/api/v0/clusters", env) }
									hx-trigger="load"
									hx-swap="innerHTML"
									hx-target="this"
									hx-on::after-swap="if(this.options.length > 0 && this.options[0].value) { selectedCluster = this.options[0].value; }"
								>
									<option value="">Loading clusters...</option>
								</select>
							}

							@form.Item() {
								@form.Label(form.LabelProps{For: "name"}) {
									Secret Name
								}
								@form.Description(form.DescriptionProps{}) {
									The name will be prefixed with RESTRICTED.&lt;cluster&gt;.&lt;type&gt;.
								}
								@input.Input(input.Props{
									Name: "name",
									Type: input.TypeText,
									Placeholder: "Enter secret name",
									Required: true,
								})
							}

							@form.Item() {
								@form.Label(form.LabelProps{For: "value"}) {
									Secret Value
								}
								@textarea.Textarea(textarea.Props{
									Name: "value",
									Placeholder: "Enter secret value",
									Rows: 6,
									Required: true,
									AutoResize: true,
								})
							}

							<div class="mb-4" x-data="{ additionalTags: {}, newTagKey: '', newTagValue: '' }">
								<label class="text-sm font-medium text-gray-700 mb-2 block">Additional Tags</label>
								<div class="flex gap-2 mb-3">
									@input.Input(input.Props{
										Name: "new-tag-key",
										Type: input.TypeText,
										Placeholder: "Tag Key",
										Attributes: templ.Attributes{
											"x-model": "newTagKey",
											"x-on:keydown.enter": "$event.preventDefault(); if(newTagKey && newTagValue) { additionalTags[newTagKey] = newTagValue; newTagKey = ''; newTagValue = ''; }",
										},
									})
									@input.Input(input.Props{
										Name: "new-tag-value",
										Type: input.TypeText,
										Placeholder: "Tag Value",
										Attributes: templ.Attributes{
											"x-model": "newTagValue",
											"x-on:keydown.enter": "$event.preventDefault(); if(newTagKey && newTagValue) { additionalTags[newTagKey] = newTagValue; newTagKey = ''; newTagValue = ''; }",
										},
									})
									@button.Button(button.Props{
										Type: button.TypeButton,
										Variant: button.VariantOutline,
										Size: button.SizeSm,
										Attributes: templ.Attributes{
											"x-on:click": "if(newTagKey && newTagValue) { additionalTags[newTagKey] = newTagValue; newTagKey = ''; newTagValue = ''; }",
										},
									}) {
										<span>Add</span>
									}
								</div>
								<div class="flex flex-wrap gap-2 min-h-[2rem]">
									<template x-for="(value, key) in additionalTags" :key="key">
										<div class="flex items-center gap-1 px-3 py-1 bg-blue-50 border border-blue-200 rounded-full text-sm">
											<span class="font-medium text-blue-900" x-text="key"></span>
											<span class="text-blue-700">:</span>
											<span class="text-blue-800" x-text="value"></span>
											<button
												type="button"
												x-on:click="delete additionalTags[key]"
												class="ml-1 text-blue-600 hover:text-blue-800 font-bold"
											>
												×
											</button>
											<input type="hidden" x-bind:name="'additional_tags[' + key + ']'" x-bind:value="value" />
										</div>
									</template>
								</div>
							</div>

							<div class="flex justify-end gap-3 mt-6">
								@button.Button(button.Props{
									Type: button.TypeButton,
									Variant: button.VariantOutline,
									Attributes: templ.Attributes{
										"x-on:click": "showCreateModal = false",
									},
								}) {
									<span>Cancel</span>
								}
								@button.Button(button.Props{
									Type: button.TypeSubmit,
									Variant: button.VariantDefault,
								}) {
									<span>Create</span>
								}
							</div>
						</form>
					</div>
				</div>
			</div>

			<!-- Secret Value Modal -->
			<div
				x-show="showValueModal"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
				class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50"
				style="display: none;"
				x-on:click.self="showValueModal = false"
			>
				<div
					id="secret-value-modal"
					class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto"
					x-transition:enter="transition ease-out duration-300"
					x-transition:enter-start="opacity-0 transform scale-95"
					x-transition:enter-end="opacity-100 transform scale-100"
					x-transition:leave="transition ease-in duration-200"
					x-transition:leave-start="opacity-100 transform scale-100"
					x-transition:leave-end="opacity-0 transform scale-95"
				>
					<!-- Content will be loaded via HTMX -->
				</div>
			</div>
		</div>
	}
}

templ SecretValueModal(value string, secretName string) {
	<div class="p-6">
		<h3 class="text-2xl font-bold mb-4 text-gray-900">Secret Value</h3>
		<div class="mb-4">
			<label class="block text-sm font-medium text-gray-700 mb-2">Secret Name</label>
			<div class="text-sm text-gray-600">{ secretName }</div>
		</div>
		<div class="mb-4">
			<label class="block text-sm font-medium text-gray-700 mb-2">Value</label>
			<div class="bg-gray-50 border border-gray-200 rounded-md p-4 font-mono text-sm break-all">
				{ value }
			</div>
		</div>
		<div class="flex justify-end">
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Attributes: templ.Attributes{
					"x-on:click": "showValueModal = false",
				},
			}) {
				<span>Close</span>
			}
		</div>
	</div>
}

templ SecretsTable(secrets []secrets.Secret, secretType string, env string) {
	<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
		<table class="w-full">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cluster</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				if len(secrets) == 0 {
					<tr>
						<td colspan="4" class="px-6 py-8 text-center text-gray-500">
							No secrets found. Create one to get started.
						</td>
					</tr>
				} else {
					for _, secret := range secrets {
						<tr class="hover:bg-gray-50">
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm font-medium text-gray-900">{ secret.Name }</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm text-gray-500">{ secret.Cluster }</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm text-gray-500">
									if secret.CreatedDate != "" {
										{ secret.CreatedDate }
									} else {
										<span class="text-gray-400">-</span>
									}
								</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
								<div class="flex gap-2">
									@button.Button(button.Props{
										Variant: button.VariantGhost,
										Size: button.SizeSm,
										Attributes: templ.Attributes{
											"hx-get": fmt.Sprintf("/%s/api/v0/secrets/get?name=%s", env, url.QueryEscape(secret.Name)),
											"hx-target": "#secret-value-modal",
											"hx-swap": "innerHTML",
											"hx-on::after-request": "showValueModal = true",
										},
									}) {
										<span>View</span>
									}
									@button.Button(button.Props{
										Variant: button.VariantDestructive,
										Size: button.SizeSm,
										Attributes: templ.Attributes{
											"hx-delete": fmt.Sprintf("/%s/api/v0/secrets?name=%s", env, url.QueryEscape(secret.Name)),
											"hx-confirm": "Are you sure you want to delete this secret?",
											"hx-target": "body",
											"hx-swap": "none",
											"hx-on::after-request": "if(event.detail.successful) { htmx.trigger('body', 'refresh'); }",
										},
									}) {
										<span>Delete</span>
									}
								</div>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}
