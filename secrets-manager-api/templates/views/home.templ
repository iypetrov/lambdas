package views

import (
	"github.com/iypetrov/lambdas/secrets-manager-api/templates"
)

templ HomePage() {
	@templates.Base() {
		<div class="flex flex-col min-h-screen justify-between w-full">
            <nav class="w-full flex justify-center py-4 text-base-100">
                <div class="flex gap-12">
                    <a href="/p/public/articles" 
                       class="text-xl font-bold hover:underline cursor-pointer">
                        Static Secrets
                    </a>
                    <a href="/p/public/projects" 
                       class="text-xl font-bold hover:underline cursor-pointer">
                        TLS Certificates
                    </a>
                </div>
            </nav>

            <div class="flex flex-col items-center justify-center flex-1 text-center px-4">
                <p class="text-lg md:text-xl max-w-md leading-relaxed">
                    Welcome to the Secrets Manager API! Securely manage your static secrets and TLS certificates with ease. Explore our documentation to get started.
                </p>
            </div>

            @templates.Footer()
        </div>
	}
}
