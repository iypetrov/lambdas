package views

import (
	"fmt"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/button"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/components"
)

templ StaticSecretsPage(env string) {
	@Layout(LayoutProps{
		Env:        env,
		ActivePage: "static-secrets",
	}) {
	<div class="w-full">
		<div class="flex justify-between items-center mb-6">
			<div>
				<h1 class="text-3xl font-bold mb-2 text-gray-900">Static Secrets</h1>
				<p class="text-gray-600">Manage your static secrets</p>
			</div>
			@components.ClusterDropdown(components.ClusterDropdownProps{Env: env})
		</div>

		<div class="mb-4 flex justify-between items-center">
			<h2 class="text-2xl font-bold text-gray-900">Static Secrets</h2>
			@button.Button(button.Props{
				Variant: button.VariantDefault,
				Attributes: templ.Attributes{
					"x-on:click": "showCreateStaticModal = true",
				},
			}) {
				<span>+ Create Secret</span>
			}
		</div>
		<div 
            id="static-secrets-table" 
            x-data={ fmt.Sprintf("{ env: '%s', loadTable() { const cluster = $store.cluster.selectedCluster || ''; const searchName = document.getElementById('static-secrets-search-name')?.value || ''; const searchTags = document.getElementById('static-secrets-search-tags')?.value || ''; let url = '/' + this.env + '/api/v0/static-secrets?cluster=' + cluster; if (searchName) url += '&search-name=' + encodeURIComponent(searchName); if (searchTags) url += '&search-tags=' + encodeURIComponent(searchTags); htmx.ajax('GET', url, { target: '#static-secrets-table', swap: 'innerHTML' }); } }", env) }
            x-init="loadTable(); document.body.addEventListener('refreshStaticSecretsTable', () => loadTable())"
            x-effect="$watch('$store.cluster.selectedCluster', () => loadTable())"
        >
			<div class="flex items-center justify-center p-8">
				<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
			</div>
		</div>
	</div>
	}
}

