package views

import (
	"fmt"
	"github.com/iypetrov/lambdas/secrets-manager-api/secrets"
	"github.com/iypetrov/lambdas/secrets-manager-api/templates/components"
)

templ DashboardPage(stats *secrets.Statistics, env string) {
	@Layout(LayoutProps{
		Env:        env,
		ActivePage: "home",
	}) {
	<div class="w-full">
		<div class="flex justify-between items-center mb-6">
			<div>
				<h1 class="text-3xl font-bold mb-2 text-gray-900">Dashboard</h1>
				<p class="text-gray-600">Manage your secrets and TLS certificates</p>
			</div>
			@components.ClusterDropdown(components.ClusterDropdownProps{Env: env})
		</div>

		<div
			id="statistics"
			x-data={ fmt.Sprintf("{ env: '%s', loadStats() { const cluster = $store.cluster.selectedCluster || ''; htmx.ajax('GET', '/' + this.env + '/api/v0/statistics?cluster=' + cluster, { target: '#statistics', swap: 'innerHTML' }); } }", env) }
			x-init="loadStats()"
			x-effect="$watch('$store.cluster.selectedCluster', () => loadStats())"
		>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
				<div class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-lg p-6 transition">
					<h3 class="font-semibold text-lg mb-2 text-gray-700">Static Secrets</h3>
					<p class="text-3xl font-bold text-gray-900">{ fmt.Sprintf("%d", stats.StaticSecretsCount) }</p>
					<p class="text-sm text-gray-500 mt-2">Total static secrets</p>
				</div>

				<div class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-lg p-6 transition">
					<h3 class="font-semibold text-lg mb-2 text-gray-700">TLS Certificates</h3>
					<p class="text-3xl font-bold text-gray-900">{ fmt.Sprintf("%d", stats.TLSCertificatesCount) }</p>
					<p class="text-sm text-gray-500 mt-2">Total TLS certificates</p>
				</div>
			</div>
		</div>

		<div
			id="audit-events-table"
			x-data={ fmt.Sprintf("{ env: '%s', loadTable() { const cluster = $store.cluster.selectedCluster || ''; htmx.ajax('GET', '/' + this.env + '/api/v0/audit-events?cluster=' + cluster, { target: '#audit-events-table', swap: 'innerHTML' }); } }", env) }
			x-init="$nextTick(() => loadTable())"
		>
			<div class="flex items-center justify-center p-8">
				<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
			</div>
		</div>
	</div>
	}
}

